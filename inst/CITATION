## When the package metadata is provided (e.g. citation("splitTypeR")), the
## information is extracted from the DESCRIPTION file to keep the citation
## in sync with the package. Otherwise (e.g. readCitationFile() called
## without 'meta'), the information below is used.

if (!is.null(meta) && !is.null(meta$Package)) {
    ## Retain only the authors (role "aut")
    authors <- eval(parse(text=meta$`Authors@R`))
    authors <- authors[vapply(authors$role, function(x) "aut" %in% x,
        logical(1))]
    title <- sprintf("%s: %s", meta$Package, meta$Title)
    year <- format(as.Date(meta$Date), "%Y")
    note <- sprintf("R package version %s", meta$Version)
} else {
    authors <- c(person("Astrid", "Desch\u00eanes"), 
        person("Pascal", "Belleau"), person(c("David", "A."), "Tuveson"))
    title <- paste0("splitTypeR: Transcriptomic Classification using ",
        "Mixture of Normal Distributions")
    year <- "2026"
    note <- "R package"
}

bibentry(bibtype="Manual",
    title=title,
    author=authors,
    year=year,
    note=note,
    url="https://github.com/adeschen/splitTypeR")
